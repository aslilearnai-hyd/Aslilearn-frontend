{
  "include": ["src/**/*", "tailwind.config.ts", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "src/components/AnimatedExamReviewModal.tsx",
    "src/components/ExamModalIntegration.tsx",
    "src/components/stream-player.tsx",
    "src/components/video-player.tsx",
    "src/pages/video-lectures.tsx"
  ],
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
